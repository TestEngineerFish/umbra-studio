{
  "name": "umbrastudio-shell",
  "private": true,
  "version": "0.1.0",
  "description": "长尾雀 Studio 桌面壳（Electron）：主进程起核心，自带 Chromium 跑体检",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --arm64",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:all": "electron-builder --mac --win",
    "dist:dir": "electron-builder --mac --arm64 --dir",
    "packtest": "node packtest.mjs",
    "shelltest": "node shelltest.mjs",
    "urlguardtest": "node urlguard.mjs",
    "dist:signed": "node dist-signed.mjs",
    "signcheck": "node signcheck.mjs",
    "_说明": "echo 'build 字段的两段说明在 shell/build-说明.md —— electron-builder 26.15.3 拒绝配置里的未知键，所以它们不能住在 build 对象里'"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.umbrastudio.app",
    "electronFuses": {
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "resetAdHocDarwinSignature": true
    },
    "productName": "Umbra Studio",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.mjs",
      "urlguard.mjs",
      "preload.cjs",
      "package.json"
    ],
    "asar": false,
    "extraResources": [
      {
        "from": "../server/dist",
        "to": "core/server/dist"
      },
      {
        "from": "../server/node_modules",
        "to": "core/server/node_modules",
        "filter": [
          "**/*",
          "!typescript/**",
          "!@types/**",
          "!.bin/**",
          "!**/*.md",
          "!**/*.map"
        ]
      },
      {
        "from": "../server/package.json",
        "to": "core/server/package.json"
      },
      {
        "from": "../runtime",
        "to": "core/runtime"
      },
      {
        "from": "../plugins",
        "to": "core/plugins"
      },
      {
        "from": "../shared",
        "to": "core/shared"
      },
      {
        "from": "../app/dist",
        "to": "core/app/dist"
      },
      {
        "from": "../keys",
        "to": "core/keys"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null,
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "timestamp": "http://timestamp.apple.com/ts01",
      "gatekeeperAssess": false,
      "extendInfo": {
        "CFBundleDisplayName": "长尾雀 Studio",
        "CFBundleName": "长尾雀 Studio",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Folder",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.folder"
            ]
          }
        ]
      }
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "dir"
      ]
    },
    "artifactName": "Quetail Studio-${version}-${os}-${arch}.${ext}",
    "compression": "normal",
    "beforePack": "./beforePack.cjs",
    "afterPack": "./afterPack.cjs",
    "fileAssociations": [
      {
        "ext": "dc.html",
        "name": "长尾雀设计稿",
        "description": "长尾雀 Studio 设计稿",
        "role": "Editor",
        "rank": "Owner"
      },
      {
        "ext": [
          "md",
          "markdown",
          "txt",
          "html",
          "htm",
          "json",
          "jsonc",
          "csv",
          "tsv",
          "svg",
          "yml",
          "yaml",
          "log",
          "conf"
        ],
        "name": "文本与数据文件",
        "description": "长尾雀 Studio 能看能改的文件",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  }
}
