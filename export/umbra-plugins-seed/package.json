{
  "name": "umbra-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "Umbra Studio 的插件仓库：SDK、插件源码、打包与校验脚本。零运行依赖。",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "validate": "node scripts/validate.mjs --all",
    "pack": "node scripts/pack.mjs --all",
    "test-vectors": "node scripts/verify-test-vectors.mjs",
    "test": "node scripts/validate.mjs --all && node scripts/verify-test-vectors.mjs",
    "sync-studio": "node scripts/sync-studio.mjs"
  }
}
