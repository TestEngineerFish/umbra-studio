{
  "name": "umbrastudio-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "长尾雀 Studio MCP server —— 本地设计稿工具，见 ../doc/00-MCP 工具契约.md",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "umbradesign": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p . && node -e \"require('fs').copyFileSync('src/plugin/net-block.cjs','dist/plugin/net-block.cjs')\"",
    "dev": "tsc -p . --watch",
    "start": "node dist/index.js",
    "ui": "node dist/ui.js",
    "check": "tsc -p . --noEmit",
    "selftest": "npm run build && node dist/selftest.js",
    "lifecycletest": "npm run build && node dist/lifecycletest.js",
    "agenttest": "npm run build && node dist/agenttest.js",
    "filetest": "npm run build && node dist/filetest.js",
    "apitest": "npm run build && node dist/apitest.js",
    "captest": "npm run build && node dist/captest.js",
    "kindtest": "npm run build && node dist/kindtest.js",
    "aifailtest": "npm run build && node dist/aifailtest.js",
    "plugintest": "npm run build && node dist/plugintest.js",
    "packplugin": "npm run build && node dist/packplugin.js",
    "sync-plugins": "npm run build && node dist/sync_plugins.js",
    "jsonpostest": "npm run build && node dist/jsonpostest.js",
    "csvpostest": "npm run build && node dist/csvpostest.js",
    "difftest": "npm run build && node dist/difftest.js",
    "catalogtest": "npm run build && node dist/catalogtest.js",
    "acquiretest": "npm run build && node dist/acquiretest.js",
    "verbtest": "npm run build && node dist/verbtest.js",
    "upgradetest": "npm run build && node dist/upgradetest.js",
    "tokentest": "npm run build && node dist/tokentest.js",
    "gaptest": "npm run build && node dist/gaptest.js",
    "converttest": "npm run build && node dist/converttest.js",
    "limitstest": "npm run build && node dist/limitstest.js",
    "identitytest": "npm run build && node dist/identitytest.js",
    "purgetest": "npm run build && node dist/purgetest.js",
    "actxtest": "npm run build && node dist/actxtest.js",
    "prefstest": "npm run build && node dist/prefstest.js",
    "plaintest": "npm run build && node dist/plaintest.js",
    "localbridgetest": "tsc -p . && node dist/localbridgetest.js"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/ws": "^8.18.1",
    "eventsource-parser": "^4.1.2",
    "playwright-core": "^1.63.0",
    "quickjs-emscripten-core": "^0.32.0",
    "ws": "^8.21.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
